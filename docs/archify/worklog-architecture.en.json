 "cards": [
  {
   "dot": "slate",
   "title": "Model input",
   "items": [
    "Rules block in the instruction file: AGENTS.md / CLAUDE.md · work selection and save procedure",
    "Record injection: recent work list + computed current state of the selected work",
    "Shared material: .worklog/project.md is injected too when present",
    "No work selected: list and selection guidance / use after the user names one"
   ]
  },
  {
   "dot": "cyan",
   "title": "Save and context-rebuild paths",
   "items": [
    "Arrow direction: caller → callee / accessor → file / reply → caller",
    "Save: validate request → append to ledger and re-read → update state and list",
    "Context rebuild: ledger → compute current state → hook injection / show·use lookup"
   ]
  },
  {
   "dot": "emerald",
   "title": "Role of each record",
   "items": [
    "events.jsonl: accumulated events per work / state.json · state.md: computed current state",
    "Core of the current state: goal · effective decisions · constraints · waiting · next action",
    "index.json: work list and metadata / stops if corrupt",
    "Work records are shared within one .worklog/ / current-work selection is per tool and session",
    "sessions/<tool>_<session>.json: current work · read seq · turn state"
   ]
  },
  {
   "dot": "amber",
   "title": "Execution conditions",
   "items": [
    "Injection points: start · resume · clear · compaction · fork",
    "Not connected · OFF: only a status notice is injected instead of work state",
    "Save: exclusive flock / rejected when the read event number (seq) is stale",
    "Stop: checks save · skip · work selection / blocks once when unmet"
   ]
  },
  {
   "dot": "rose",
   "title": "Responsibility and trust boundaries",
   "items": [
    "Host: instructions · hook registration · execution rights / past records ≠ new approval",
    "Record tool: validates input · references · quotes · seq / does not vouch for content truth",
    "Frames: responsibility · file access · network boundaries / no OS isolation"
   ]
  },
  {
   "dot": "violet",
   "title": "Runtime base and external dependencies",
   "items": [
    "Hooks and record tool: same wl.py entry points and shared functions / Python · POSIX",
    "Artifacts: created by the agent → record tool reads the file and checks its hash",
    "Update check: notify · interval met → separate process → Git origin lookup / never applied automatically"
   ]
  }
 ]
}